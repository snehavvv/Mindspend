# ─── Finlytics Backend — Environment Variables ────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to version control.

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=finlytics

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_at_least_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]
